{
  "name": "soroban-verification-service",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --continue",
    "test:smoke": "pnpm --filter @scvs/e2e-tests run test:smoke",
    "test:perf:locust": "bash test/performance/run-perf01-locust.sh",
    "test:perf:locust:open": "bash test/performance/run-perf02-open-locust.sh",
    "dev:verification-svc": "pnpm --filter @scvs/verification-svc run dev",
    "dev:orchestrator-svc": "pnpm --filter @scvs/orchestrator-svc run dev",
    "dev:query-svc": "pnpm --filter @scvs/query-svc run dev",
    "dev:web": "pnpm --filter soroban-verify-web run dev -- --port 5173",
    "db:migrate": "pnpm --filter @scvs/db --filter @scvs/db-query run prisma:deploy",
    "db:migrate:new": "pnpm --filter @scvs/db exec prisma migrate dev --create-only",
    "db:migrate:status": "pnpm --filter @scvs/db --filter @scvs/db-query exec prisma migrate status",
    "db:seed-tvl": "tsx scripts/seed-tvl.ts",
    "db:reset:local": "node eng-tools/reset-local-db.mjs",
    "generate:openapi": "turbo run generate:openapi",
    "generate:api-client": "turbo run generate --filter=@scvs/verify-api-client",
    "generate:env-contract": "node eng-tools/generate-env-contract.mjs",
    "generate:deploy-env": "node eng-tools/generate-deploy-env.mjs",
    "generate:contract-snapshot": "pnpm --filter @scvs/core run contract:snapshot",
    "generate:differential-oracles": "node eng-tools/pin-differential-oracles.mjs",
    "generate:third-party-notices": "node eng-tools/generate-third-party-notices.mjs",
    "check:env": "node eng-tools/check-env-manifest.mjs",
    "check:workflows": "node eng-tools/check-workflow-syntax.mjs",
    "check:workflow-pins": "node eng-tools/check-workflow-pins.mjs",
    "check:credentialed-jobs": "node eng-tools/check-credentialed-jobs.mjs",
    "check:secrets": "node eng-tools/check-secrets.mjs",
    "check:deployment-data": "node eng-tools/check-deployment-data.mjs",
    "check:test-row-cleanup": "node eng-tools/check-test-row-cleanup.mjs",
    "check:builder-isolation": "node eng-tools/check-builder-isolation.mjs",
    "check:http-timeouts": "node eng-tools/check-http-timeouts.mjs",
    "check:fixture-tables": "node eng-tools/check-fixture-tables.mjs",
    "check:mount-paths": "node eng-tools/check-mount-paths.mjs",
    "check:host-routing": "node eng-tools/check-host-routing.mjs",
    "check:composition-template": "node eng-tools/check-composition-template.mjs",
    "check:composition-matrix": "node eng-tools/check-composition-matrix.mjs",
    "check:tool-index": "node eng-tools/check-tool-index.mjs",
    "check:docs": "node eng-tools/check-docs.mjs",
    "deploy:render-taskdef": "node eng-tools/render-taskdef.mjs",
    "deploy:sync-secrets": "node eng-tools/sync-secrets.mjs",
    "deploy:check-taskdef": "node eng-tools/check-taskdef-boundary.mjs",
    "deploy:check-descriptor": "node eng-tools/check-descriptor-fields.mjs",
    "deploy:check-config-contract": "node eng-tools/assert-config-contract.mjs",
    "deploy:check-host-routing": "node eng-tools/assert-host-routing.mjs",
    "deploy:check-ref": "node eng-tools/assert-deploy-ref.mjs",
    "deploy:check-sdk-channel": "node eng-tools/assert-sdk-channel-alignment.mjs",
    "release:resolve-channel": "node eng-tools/resolve-release-channel.mjs",
    "release:stamp-version": "node eng-tools/stamp-sdk-version.mjs",
    "release:check-dist-tags": "node eng-tools/check-published-dist-tags.mjs",
    "e2e:generate-inventory": "node eng-tools/generate-e2e-ci-inventory.mjs",
    "e2e:check-fixtures": "node eng-tools/check-e2e-fixture-inventory.mjs",
    "e2e:generate-upgrade-inventory": "node eng-tools/generate-e2e-upgrade-inventory.mjs",
    "e2e:check-upgrade-fixtures": "node eng-tools/check-e2e-upgrade-inventory.mjs",
    "e2e:summary": "node eng-tools/write-e2e-summary.mjs",
    "report:advisories": "node eng-tools/report-advisories.mjs"
  },
  "devDependencies": {
    "@scvs/config": "workspace:*",
    "@scvs/core": "workspace:*",
    "@scvs/db": "workspace:*",
    "@scvs/db-query": "workspace:*",
    "@scvs/storage-layout": "workspace:*",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "ws": "^8.21.3",
      "csv-parse": "^7.0.2",
      "mysql2": "^3.23.1",
      "js-yaml@^4.0.0": "^4.3.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
