datasource db {
  provider = "postgresql"
}

// importFileExtension = "js" is required by anything that runs the compiled output.
generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "js"
}


model TrustedVerifier {
  verifierId  String   @id @map("verifier_id")
  manifestUrl String   @map("manifest_url")
  resultsRoot String   @map("results_root")
  displayName String?  @map("display_name")
  trustTier   String?  @map("trust_tier")
  status      String   @default("active")
  addedAt     DateTime @default(now()) @map("added_at")
  bulkLoadUrl String? @map("bulk_load_url")

  @@map("trusted_verifiers")
}

model VerificationResult {
  verifierId            String    @map("verifier_id")
  wasmHash              String    @map("wasm_hash")
  status                String
  schemaVersion         String?   @map("schema_version")
  verifier              Json?
  recipeSource          String?   @map("recipe_source")
  imageTrustLevel       String?   @map("image_trust_level")
  recipe                Json?
  verifiedSourceCodeUris Json?    @map("verified_source_code_uris")
  resultsUrls           Json?     @map("results_urls")
  processedAt           DateTime? @map("processed_at")
  retrievedAt           DateTime  @map("retrieved_at")

  @@id([verifierId, wasmHash])
  @@index([wasmHash])
  @@map("verification_result")
}

model VerifierSyncCursor {
  verifierId String    @id @map("verifier_id")
  cursor     String?
  updatedAt  DateTime? @map("updated_at")
  lastError  String?   @map("last_error")
  lastErrorReason String? @map("last_error_reason")

  @@map("verifier_sync_cursor")
}

model AggregatedWasmIndex {
  wasmHash             String   @id @map("wasm_hash")
  aggregationUpdatedAt DateTime @map("aggregation_updated_at")
  // sha256 over the canonicalised entry set; changes only when an entry appears, changes or is withdrawn.
  entriesDigest        String   @map("entries_digest")

  @@index([aggregationUpdatedAt, wasmHash])
  @@map("aggregated_wasm_index")
}
