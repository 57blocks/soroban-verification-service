{
  "name": "@scvs/storage-layout",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./shapes": {
      "types": "./dist/src/shapes.d.ts",
      "default": "./dist/src/shapes.js"
    },
    "./keys": {
      "types": "./dist/src/keys.d.ts",
      "default": "./dist/src/keys.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "c8 sh -c 'for f in src/*-test.ts; do tsx \"$f\" || exit 1; done'"
  },
  "dependencies": {
    "@scvs/aws": "workspace:*",
    "@scvs/core": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "c8": "^12.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
