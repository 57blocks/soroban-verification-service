{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": [
    "POSTGRES_HOST",
    "POSTGRES_PORT",
    "POSTGRES_DB",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "generate:openapi": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"]
    },

    "generate": {
      "dependsOn": ["@scvs/verification-svc#generate:openapi"],
      "outputs": ["src/generated/**"]
    },
    "@scvs/verify-api-client#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "soroban-verify-docs#build": {
      "dependsOn": ["^build", "@scvs/verification-svc#generate:openapi", "@scvs/query-svc#generate:openapi"],
      "outputs": ["dist/**"]
    },
    "soroban-verify-web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["SCVS_BUILD_COMMIT", "SCVS_BUILD_DATE"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
