# Copy to `.env`. Precedence: an injected variable > `<service>/.env` > this file.

# Shared: Postgres from docker/docker-compose.yml; DATABASE_URL, if set, wins over all five.
POSTGRES_HOST="localhost"
POSTGRES_PORT="5433"
POSTGRES_DB="scvs"
POSTGRES_USER="scvs"
POSTGRES_PASSWORD="scvs_local_dev"

# verification-svc
# HMAC key for the rate-limit fingerprint; required, any non-empty string works locally.
SCVS_ABUSE_FINGERPRINT_KEY="local-dev-not-a-secret"

# Terms/privacy bundle: a workspace-relative path, an absolute path, or an https: URL; required.
SCVS_LEGAL_DOCUMENTS_SOURCE="config/legal-documents.example.json"

# The scratch bucket (uploads, builder hand-off), not the published results bucket.
SCVS_STORAGE_BUCKET=scvs-local-scratch
