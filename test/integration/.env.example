# Copy to `test/integration/.env`. Nothing in this package runs unless SCVS_E2E=1.
SCVS_E2E=1

SCVS_E2E_VERIFY_URL="https://verify.example.io"
SCVS_E2E_QUERY_URL="https://query.example.io"
# Origin only, not a page URL.
SCVS_E2E_WEB_URL="https://verify.example.io"
# The deployment's SCVS_PUBLIC_RESULT_ROOT (the static result tree origin).
SCVS_E2E_RESULT_ROOT="https://results.example.io"

SCVS_E2E_NETWORK="testnet"

# SCVS_E2E_ALLOW_PERF=1
# auto | slow | all
# SCVS_E2E_AUTO_SCOPE="auto"
# Turns every recorded divergence in support/conformance.ts into a hard failure.
# SCVS_E2E_STRICT_TRD=1

SCVS_E2E_JOB_TIMEOUT_MS=1200000
SCVS_E2E_POLL_INTERVAL_MS=3000
SCVS_E2E_REQUEST_TIMEOUT_MS=30000

# SCVS_E2E_FIXTURES="fixtures/e2e-fixtures.dev.json"

# Name of a funded Stellar key imported into the local CLI, never a secret key.
# SCVS_FIXTURE_TESTNET_ACCOUNT="scvs-e2e-local"

# Setting it skips the verifier-manifest.json read.
# SCVS_E2E_VERIFIER_URL="https://results.dev.sv.example.com"
# SCVS_E2E_VERIFIER_NAME="SCVS Dev Verifier"

# An archive that compiles to F-LEG-1's deployed bytes.
# SCVS_E2E_PRIVATE_UPLOAD_PATH="/abs/path/to/f-leg-1-source.tar.gz"

# dev | staging: reads archive bounds and retry policy from config/deploy/<env>/; unset for an unmanaged deployment.
# SCVS_E2E_ENV="dev"

# SCVS_E2E_QUOTA_SUBMIT=""
# SCVS_E2E_WINDOW_SUBMIT_MS=""
# SCVS_E2E_QUOTA_QUERY=""
# SCVS_E2E_WINDOW_QUERY_MS=""
# SCVS_E2E_LIMIT_WALLCLOCK_MS=""
# SCVS_E2E_LIMIT_SSE_CONNECTIONS=""
# SCVS_E2E_PERF_DRAIN_TIMEOUT_MS="14400000"
# SCVS_E2E_PERF_USERS="10"
# SCVS_E2E_PERF_DURATION_SECONDS="3600"
# SCVS_E2E_PERF_THINK_TIME_SECONDS="60"
# SCVS_E2E_PERF_MAX_REBUILDS="500"
# SCVS_E2E_PERF_OUTPUT_DIR="artifacts/e2e-reports/perf-01"
# SCVS_E2E_PERF_OPEN_DURATION_SECONDS="600"
# SCVS_E2E_PERF_OPEN_BURST_SIZE="20"
# SCVS_E2E_PERF_OPEN_BURST_INTERVAL_SECONDS="5"
# SCVS_E2E_PERF_OPEN_MAX_IN_FLIGHT="20"
