AWS_REGION=ap-southeast-2
AWS_SDK_LOAD_CONFIG=1
AWS_PROFILE=default

SCVS_BATCH_JOB_QUEUE_ARN_ARM64=xxxx
SCVS_BATCH_JOB_QUEUE_ARN_AMD64=xxxx
# Queue for an image that runs on both architectures, and when the registry cannot say: arm64 (default) or amd64.
# SCVS_BATCH_DEFAULT_ARCH=arm64
# A job definition family name (or a revision ARN), despite the `_ARN` suffix.
SCVS_BATCH_JOB_DEFINITION_ARN_ARM64=scvs-builder-local
SCVS_BATCH_JOB_DEFINITION_ARN_AMD64=scvs-builder-local-amd64

# Must not be the builder's queue or job definition. Optional locally.
# SCVS_COMPOSER_JOB_QUEUE_ARN=xxxx
# SCVS_COMPOSER_JOB_DEFINITION_ARN=scvs-composer-local

# A bare repository URI: no tag, no `@sha256:` suffix.
# SCVS_COMPOSED_ENVIRONMENT_REPOSITORY_URI=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/scvs-composed-environments

SCVS_JOB_STATE_CHANGE_QUEUE_URL=xxxxx

# The scratch bucket, not the published-results one.
SCVS_STORAGE_BUCKET=scvs-local-scratch

# Declares this is the only orchestrator writing the result tree; the filesystem backend refuses to start without it.
SCVS_SINGLE_WRITER=true
