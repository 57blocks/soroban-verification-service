# Values only orchestrator-svc needs. Everything shared — POSTGRES_*, STELLAR_CLI_PATH,
# SCVS_ARTIFACT_DIR — lives in the repository root `.env` (see the root `.env.example`), which this
# file layers on top of: anything set here wins for this service only.
#
#     cp .env.example .env                                # repository root, shared baseline
#     cp services/orchestrator-svc/.env.example services/orchestrator-svc/.env

# Local dev, wired to the real AWS account (123456789012 / ap-southeast-2, "scvs" profile). There is
# no in-process build path to opt out of: dispatch to AWS Batch is unconditional (ADR-003), which is
# why this file no longer sets `SCVS_BUILD_DISPATCH` — no code has read it since the fallback was
# removed. See `config/env-manifest.yaml`'s `retired:` block.

AWS_REGION=ap-southeast-2
AWS_SDK_LOAD_CONFIG=1
AWS_PROFILE=default

# Real Batch resources. Two queues, both DevOps's Terraform-managed —
# sv-dev-builders-arm-queue (Graviton) and sv-dev-builders-x86-queue — because each compute
# environment is single-architecture and the build image is pulled and run on that host. Dispatch picks
# from the image's own published architecture.
SCVS_BATCH_JOB_QUEUE_ARN_ARM64=xxxx
SCVS_BATCH_JOB_QUEUE_ARN_AMD64=xxxx
# Optional. Which queue takes an image that runs on both, and the fallback when the registry cannot
# say. arm64 (the default) keeps local dev on the compute environment every build so far has used.
# SCVS_BATCH_DEFAULT_ARCH=arm64
# A job definition FAMILY NAME, despite the `_ARN` suffix. SubmitJob takes either and
# resolves the latest ACTIVE revision of the family itself. A revision ARN still works if you need to
# pin one locally. One family per architecture — the builder image is single-architecture per family,
# not a multi-arch index, so the arm64 and amd64 families are two separate registrations.
SCVS_BATCH_JOB_DEFINITION_ARN_ARM64=scvs-builder-dev
# The amd64 counterpart, a distinct family from the arm64 one above. Needed by any target whose build
# image publishes amd64 only — every cli-58 contract does, because stellar/stellar-cli is amd64-only
# upstream. Unset, such a dispatch fails naming this variable instead of silently running arm64's
# image on an x86 host.
SCVS_BATCH_JOB_DEFINITION_ARN_AMD64=scvs-builder-dev-amd64

# ── Composed build environments (ADR-017) ──────────────────────────────────────────────────────────
# The composer fleet: a SECOND queue and job definition, deliberately not the builder's. That
# separation is the CE4 mechanism between fleets — composer and builder never share a host because
# they are different compute environments — so pointing these at the builder's resources would
# silently dissolve the guarantee while still appearing to work.
#
# All three may be left unset locally: nothing needs them until a cli-legacy target actually reaches
# composition, and `ComposerDispatchService` then throws naming the missing variable rather than
# leaving the target stuck with no explanation.
# SCVS_COMPOSER_JOB_QUEUE_ARN=xxxx
# SCVS_COMPOSER_JOB_DEFINITION_ARN=scvs-composer-dev   # family name too — see above

# The private ECR repository composed environments are pushed to and pulled from. A BARE repository
# URI — no tag, no `@sha256:` suffix; the digest is appended by `composedEnvironmentImageReference()`,
# and a tag here would produce exactly the tag-derived environment reference plan.md §6 forbids
# (rejected at boot by OrchestratorSvcEnvDto for that reason).
# SCVS_COMPOSED_ENVIRONMENT_REPOSITORY_URI=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/scvs-composed-environments

# EventBridge rule + SQS queue (Terraform-managed, resource name scvs-<env>-batch-job-state-change):
# routes AWS Batch's own "Batch Job State Change" events (filtered to SUCCEEDED/FAILED) to this
# queue, which BatchEventConsumerService long-polls.
SCVS_JOB_STATE_CHANGE_QUEUE_URL=xxxxx

# staging/{rebuildId}/{mode}/recipe.json handoff bucket (packages/config's
# getStagingStorageConfig). This is the *scratch* bucket, not the published-results one —
# The two buckets are split deliberately, and the presigned PUT handed to
# the builder and the read back in the orchestrator both resolve through this one value, so a wrong
# value here makes every rebuild resolve as `batch_job_failed_no_artifact` rather than failing loudly.
SCVS_STORAGE_BUCKET=sv-dev-scratch

# The default filesystem result tree cannot make a conditional write hold across processes
# (docs/invariants.md rule 38), so the service refuses to start until a deployment states that only one
# orchestrator writes that tree. A local dev run is one.
SCVS_SINGLE_WRITER=true
